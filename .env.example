# ==============================================================================
# Environment Variables Specification for Render Deployment
# ==============================================================================

# Core Settings
PORT=8000
SECRET_KEY=generate-a-secure-random-key-for-jwt-signing
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Database Configuration (Defaults to SQLite; set PostgreSQL DSN for production)
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname
DATABASE_URL=sqlite:///./health_explained.db

# External LLM & AI Cloud Keys
GROQ_API_KEY=your_groq_api_key_here
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=health-explained

# Optional Cloud Storage / S3 Configuration
# S3_BUCKET_NAME=ruralcare-ai-storage
# AWS_ACCESS_KEY_ID=your_aws_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret
